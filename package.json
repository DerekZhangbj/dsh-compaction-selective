{
  "name": "dsh-compaction-selective",
  "version": "0.1.0",
  "private": false,
  "description": "Human-directed selective compaction for DeepSeek Harness: fold an explicitly requested span of earlier turns (recent or arbitrary) into one summary, with a mandatory approval prompt and a fold-shaped summary template.",
  "type": "module",
  "main": "lib/index.js",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "compaction",
    "context-engineering",
    "plugin"
  ],
  "files": [
    "lib/",
    "cordis.patch.yml",
    "patches/",
    "README.md",
    "NOTICE",
    "LICENSE",
    "README.zh.md"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./range": {
      "default": "./lib/range.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-preset-registry": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node tests/run.mjs",
    "test:all": "node tests/run.mjs"
  },
  "license": "MIT",
  "author": "the dsh-compaction-selective contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DerekZhangbj/dsh-compaction-selective.git"
  },
  "homepage": "https://github.com/DerekZhangbj/dsh-compaction-selective#readme",
  "bugs": {
    "url": "https://github.com/DerekZhangbj/dsh-compaction-selective/issues"
  }
}
